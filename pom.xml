<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/>
	</parent>

	<groupId>com.developerander</groupId>
	<artifactId>microservice.colegio</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>microservice-colegio</name>
	<description>Microservicio de Matrículas SOA — Colegio | APF3</description>

	<properties>
		<java.version>17</java.version>
		<!-- Versión centralizada de JJWT para no repetirla en cada dependencia -->
		<jjwt.version>0.12.3</jjwt.version>
	</properties>

	<dependencies>

		<!-- ══════════════════════════════════════════════════════════
		     SPRING WEB MVC
		     Habilita @RestController, @RequestMapping, Tomcat embebido.
		     También incluye RestTemplate para llamadas HTTP entre servicios.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     SPRING DATA JPA
		     ORM Hibernate + JpaRepository para acceso a MySQL.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     VALIDATION
		     Activa @NotNull, @Valid, @Size en entidades y DTOs.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     SPRING AMQP — RabbitMQ
		     Permite publicar y consumir mensajes asincrónicos.
		     Simula la mensajería SOA entre MatriculaService y NotificacionService.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     JJWT — API
		     Interfaz pública para crear y leer tokens JWT.
		     Simula la validación que hace el ESB (WSO2) en producción.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     JJWT — Implementación (runtime)
		     Motor interno de JJWT. Solo se necesita al ejecutar.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     JJWT — Jackson (serialización JSON de claims)
		     Permite leer el payload del JWT como JSON.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     MYSQL CONNECTOR
		     Driver JDBC para conectar con MySQL 8+.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     LOMBOK
		     Genera getters, setters, builders, constructores con anotaciones.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     SPRINGDOC OPENAPI (SWAGGER UI)
		     Genera documentación interactiva de la API REST.
		     Incluye botón "Authorize" para pasar el JWT en Swagger UI.
		     http://localhost:8080/swagger-ui.html
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.6.0</version>
		</dependency>

		<!-- ══════════════════════════════════════════════════════════
		     SPRING BOOT TEST
		     JUnit 5, Mockito, MockMvc para pruebas unitarias.
		     ══════════════════════════════════════════════════════════ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
